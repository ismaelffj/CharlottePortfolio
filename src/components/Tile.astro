---
import { Image } from 'astro:assets';
import type { Piece } from '../lib/pieces';
import type { TileKind } from '../lib/tiles';
import { captionMeta } from '../lib/captions';

interface Props {
  piece: Piece;
  kind: TileKind;
  categoryName: string;
}

const { piece, kind, categoryName } = Astro.props;
const meta = captionMeta(piece, categoryName);
---
<a class="tile-link" href={piece.url}>
  {kind === 'image' && piece.image && (
    <div class="tile image">
      <Image
        src={piece.image}
        alt={piece.imageAlt}
        width={262}
        widths={[262, 320, 524]}
        sizes="(max-width: 639px) calc(50vw - 28px), (max-width: 1023px) calc(33vw - 40px), 262px"
      />
    </div>
  )}
  {kind === 'paper' && (
    <div class="tile paper">
      <span class="label meta">{categoryName}</span>
      <span class="paper-title display">{piece.title}</span>
      <span class="lines">{piece.openingLines}</span>
    </div>
  )}
  {(kind === 'rose' || kind === 'green') && (
    <div class:list={['tile', kind]}>
      <span class="italic display">{piece.title}</span>
    </div>
  )}
  <span class="caption-title">{piece.title}</span>
  <span class="caption-meta meta">{meta}</span>
</a>

<style>
  .tile-link { display: block; color: var(--text); text-decoration: none; }
  .tile { position: relative; aspect-ratio: 1 / 1; overflow: hidden; }
  .tile::after { content: ''; position: absolute; inset: 0; pointer-events: none; }
  .tile.image::after { box-shadow: inset 0 0 0 1px var(--keyline); }
  .tile.image :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tile.paper { background: var(--paper); color: var(--paper-ink); padding: 18px; display: flex; flex-direction: column; }
  .label { font-size: 11px; letter-spacing: 0.05em; color: var(--paper-label); margin-bottom: 10px; }
  .paper-title { font-size: 22px; line-height: 1.1; font-weight: 300; margin-bottom: 12px; }
  .lines {
    font-size: 15px;
    line-height: 1.4;
    font-weight: 450;
    color: var(--paper-text);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tile.rose { background: var(--rose-tile); }
  .tile.green { background: var(--green); }
  .tile.green::after { box-shadow: inset 0 0 0 1px var(--keyline-strong); }
  .italic {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    font-style: italic;
    font-weight: 340;
    font-size: 22px;
    line-height: 1.12;
  }
  .tile.rose .italic { color: var(--wine); }
  .tile.green .italic { color: var(--rose); }
  .caption-title {
    display: block;
    margin-top: 14px;
    font-size: 20px;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition);
  }
  .tile-link:hover .caption-title { text-decoration-color: color-mix(in srgb, var(--rose) 50%, transparent); }
  .tile-link:focus-visible { outline: none; }
  .tile-link:focus-visible .tile { outline: 2px solid var(--rose); outline-offset: 2px; }
  .caption-meta { display: block; margin-top: 4px; font-size: 13px; color: var(--muted); }
  @media (max-width: 639px) {
    .tile.paper { padding: 12px; }
    .label { margin-bottom: 6px; }
    .paper-title { font-size: 18px; line-height: 1.15; }
    .lines { display: none; }
    .italic { left: 12px; right: 12px; bottom: 12px; font-size: 17px; }
    .caption-title { margin-top: 10px; font-size: 17px; font-weight: 450; }
    .caption-meta { font-size: 12px; }
  }
</style>
