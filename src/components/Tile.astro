---
import TileSquare from './TileSquare.astro';
import type { Piece } from '../lib/pieces';
import type { TileKind } from '../lib/tiles';
import { captionMeta, extraLineText } from '../lib/captions';

interface Props {
  piece: Piece;
  kind: TileKind;
  categoryName: string;
  /** How many squares sit across the grid on desktop, which decides the image widths served. */
  perRow: number;
}

const { piece, kind, categoryName, perRow } = Astro.props;
const line = extraLineText(piece);
---
<a class="tile-link" href={piece.url}>
  <TileSquare piece={piece} kind={kind} categoryName={categoryName} size="grid" perRow={perRow} />
  <span class="caption-title">{piece.title}</span>
  {line && <span class="caption-line">{line}</span>}
  <span class="caption-meta meta">{captionMeta(piece)}</span>
</a>

<style>
  .tile-link { display: block; color: var(--text); text-decoration: none; }
  .caption-title {
    display: block;
    margin-top: 14px;
    font-size: 20px;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition);
  }
  .tile-link:hover .caption-title { text-decoration-color: color-mix(in srgb, var(--rose) 50%, transparent); }
  .tile-link:focus-visible { outline: none; }
  .tile-link:focus-visible :global(.tile) { outline: 2px solid var(--rose); outline-offset: 2px; }
  .caption-line { display: block; margin-top: 4px; font-size: 15px; line-height: 1.4; font-weight: 450; color: var(--muted); }
  .caption-meta { display: block; margin-top: 4px; font-size: 13px; color: var(--muted); }
  .caption-line + .caption-meta { margin-top: 6px; }
  @media (max-width: 639px) {
    .caption-title { margin-top: 10px; font-size: 17px; font-weight: 450; }
    .caption-line { font-size: 14px; }
    .caption-meta { font-size: 12px; }
  }
</style>
