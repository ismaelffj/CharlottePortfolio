---
interface Props {
  label: string;
}

const { label } = Astro.props;
---
<div class="wrap">
  <section class="row">
    <h2 class="label">{label}</h2>
    <div class="text">
      <slot />
    </div>
  </section>
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 32px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }
  .label { font-style: italic; font-size: 15px; font-weight: 400; color: var(--text); padding-top: 3px; }
  .text { max-width: 600px; font-size: 18px; line-height: 1.55; }
  :global(body.wine) .text { font-weight: 450; }
  .text :global(p + p) { margin-top: 12px; }
  @media (max-width: 899px) {
    .row { grid-template-columns: 1fr; gap: 6px; padding: 24px 0; }
    .text { font-size: 16px; line-height: 1.5; }
  }
</style>
