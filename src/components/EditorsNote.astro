---
interface Props {
  text: string;
}

const { text } = Astro.props;
---
<aside class="note">
  <p class="label meta">Editor’s note</p>
  <p class="text">{text}</p>
</aside>

<style>
  .note { padding: 24px 0; border-bottom: 1px solid var(--line); }
  .label { font-size: 11px; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 8px; }
  .text { font-style: italic; font-size: 16px; line-height: 1.5; font-weight: 450; color: var(--paper-text); white-space: pre-line; }
</style>
