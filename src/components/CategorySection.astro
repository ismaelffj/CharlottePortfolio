---
import Tile from './Tile.astro';
import type { Section } from '../lib/pieces';
import { tileKinds } from '../lib/tiles';

interface Props {
  section: Section;
}

const { section } = Astro.props;
const kinds = tileKinds(section.pieces);
---
<div class="wrap">
  <section class="category" aria-labelledby={section.slug}>
    <h2 class="heading display" id={section.slug}>{section.name}</h2>
    <ul class="grid">
      {section.pieces.map((piece, index) => (
        <li>
          <Tile piece={piece} kind={kinds[index]} categoryName={section.name} />
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  .category { border-top: 1px solid var(--line); padding: 40px 0 64px; }
  .heading { font-size: 30px; line-height: 1.2; font-weight: 400; margin-bottom: 24px; scroll-margin-top: 32px; }
  .grid { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  @media (max-width: 1023px) { .grid { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  @media (max-width: 639px) {
    .category { padding: 32px 0 48px; }
    .heading { font-size: 26px; }
    .grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
</style>
