---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { smartQuotes } from '../lib/text';

interface Props {
  statement: string;
  portrait: ImageMetadata | null;
  alt: string;
}

const { statement, portrait, alt } = Astro.props;
---
<section class="wrap">
  <div class="hero">
    <h1 class="statement display">{smartQuotes(statement)}</h1>
    {portrait && (
      <div class="portrait">
        <Image src={portrait} alt={alt} width={320} densities={[1, 2]} priority />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 64px;
    align-items: center;
    margin: 48px 0 72px;
  }
  .statement {
    font-size: 44px;
    line-height: 1.1;
    font-weight: 340;
    letter-spacing: 0;
    text-wrap: balance;
    hanging-punctuation: first;
    max-width: 600px;
  }
  .portrait { position: relative; aspect-ratio: 4 / 5; overflow: hidden; }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px var(--keyline);
    pointer-events: none;
  }
  @media (max-width: 1023px) {
    .hero { grid-template-columns: 1fr 260px; gap: 40px; }
    .statement { font-size: 36px; }
  }
  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; gap: 28px; margin: 40px 0 48px; }
    .portrait { max-width: 320px; }
  }
  @media (max-width: 639px) {
    .hero { gap: 24px; margin: 32px 0 40px; }
    .statement { font-size: 30px; line-height: 1.12; }
    .portrait { max-width: 280px; }
  }
</style>
